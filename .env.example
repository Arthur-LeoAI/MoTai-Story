# 只需要选择当前服务商并填写对应 Key。模型和官方接口会在连接检测时自动选择。
# AI_PROVIDER options: openai, deepseek
AI_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MAX_OUTPUT_TOKENS=3200
OPENAI_TIMEOUT_MS=30000

# Optional: use a separate OpenAI-compatible image API for covers/home art.
# Leave IMAGE_API_KEY empty if the text API is OpenAI/custom and can also generate images.
IMAGE_API_KEY=your_image_api_key_here
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1
IMAGE_TIMEOUT_MS=60000

# Optional, required if your network needs a local proxy.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
