# AI_PROVIDER options: openai, deepseek, moonshot, zhipu, custom, local
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ENDPOINT options: responses, chat, local
OPENAI_ENDPOINT=responses
OPENAI_MAX_OUTPUT_TOKENS=3200
OPENAI_TIMEOUT_MS=30000

# Optional: use a separate OpenAI-compatible image API for covers/home art.
# Leave IMAGE_API_KEY empty if the text API is OpenAI/custom and can also generate images.
IMAGE_API_KEY=your_image_api_key_here
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1
IMAGE_TIMEOUT_MS=60000

# Keep this enabled if you want the demo to produce local fallback content
# when the remote API is unavailable.
AI_LOCAL_FALLBACK=1

# Optional, required if your network needs a local proxy.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
